# Production public URL. Frontend uses relative /api paths; this is used when generating shareable links.
PUBLIC_BASE_URL=https://brave-hub.onrender.com
APP_URL=https://brave-hub.onrender.com
NODE_ENV=production

# Admin credentials: set these only in Render Environment Variables. Never commit real values.
ADMIN_EMAIL=change-me@example.com
ADMIN_PASSWORD=change-this-password

# Optional email settings. Password reset email can work when these are configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Unique BRAVE <no-reply@example.com>

# Optional Twilio Verify. If blank, phone verification remains optional.
TWILIO_VERIFY_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
