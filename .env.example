# UNIQUE BRAVE / BRAVE CMD environment
NODE_ENV=production
PORT=10000
BRAVE_DB_PATH=./backend/brave.db
PUBLIC_BASE_URL=https://brave-hub.onrender.com
APP_URL=https://brave-hub.onrender.com

# Admin — set real values only in Render/local .env; never commit secrets.
ADMIN_EMAIL=olasimboabiodun25@gmail.com
ADMIN_PASSWORD=OLAKUNLE12@
ADMIN_CHAT_TIMEOUT_MINUTES=30

# Password reset email — use a verified sending domain for production deliverability.
RESEND_API_KEY=
RESEND_FROM=UNIQUE BRAVE <noreply@uniquebrave.dpdns.org>
RESEND_REPLY_TO=support@

# Optional phone verification
TWILIO_VERIFY_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Persistent encrypted account snapshots
BRAVE_STORAGE_KEY=AMINATOMOLABAKE
BRAVE_MIGRATED_DIR=./storage/migrated
BRAVE_AUTO_DB_BACKUP=false

# Persistent login/session window
BRAVE_SESSION_DAYS=90

# Optional AI provider keys
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payment configuration. Existing BRAVE bank/payment settings remain authoritative.
PAYMENT_PROVIDER=manual
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=

# Public BRAVE contact shown where configured
