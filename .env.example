# UNIQUE BRAVE local/Render environment variables
NODE_ENV=production
PORT=10000
BRAVE_DB_PATH=./backend/brave.db
PUBLIC_BASE_URL=https://brave-hub.onrender.com
APP_URL=https://brave-hub.onrender.com

# ADMIN LOGIN — change the password yourself
ADMIN_EMAIL=your-admin-email@example.com
# Set a strong private administrator password. Never commit your real .env.
ADMIN_PASSWORD=change-this-private-admin-password

ADMIN_PASSWORD=change-this-password
ADMIN_CHAT_TIMEOUT_MINUTES=30

# PASSWORD RESET EMAIL — Resend HTTPS API (no SMTP credentials required)
RESEND_API_KEY=re_your_resend_api_key
RESEND_FROM=UNIQUE BRAVE <no-reply@your-verified-domain.com>

# Optional phone verification
TWILIO_VERIFY_SERVICE_SID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Persistent encrypted user-record snapshot key (never commit the real value)
BRAVE_STORAGE_KEY=replace-with-a-long-random-secret
# Optional persistent migration directory. On Render use a mounted persistent disk path.
BRAVE_MIGRATED_DIR=./storage/migrated
# Optional: create a DB backup at startup when true
BRAVE_AUTO_DB_BACKUP=false

# Persistent login/session window (auto-renewed while active)
BRAVE_SESSION_DAYS=90
# Encrypted migration/backup folder
# Optional automatic DB backup

# Optional AI provider keys (keep secrets only in Render environment variables)
OPENAI_API_KEY=
GEMINI_API_KEY=

# Payment provider placeholders. Manual/admin-verified payment remains the default until a provider is configured.
PAYMENT_PROVIDER=manual
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
OPAY_PUBLIC_KEY=
OPAY_SECRET_KEY=

# Optional public BRAVE Admin contact shown on public pages
PUBLIC_CONTACT_PHONE=0813 843 2348
PUBLIC_CONTACT_EMAIL=
